# LLM used by agents (OpenAI-compatible).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ADR_LLM_MODEL=gpt-4.1-mini

# DeepResearch Bench official judges (RACE / FACT).
# Pick one backend. OpenRouter is the DRB default.
LLM_BACKEND=openrouter
OPENROUTER_API_KEY=
# OPENAI_API_KEY=   # if LLM_BACKEND=openai
JINA_API_KEY=

# DeepResearch Gym official judges (quality / citation / KPR).
# Uses OPENAI_API_KEY above. Override the judge model in config if needed.
ADR_GYM_JUDGE_MODEL=gpt-4.1-mini

# Live web search for DeepResearch Bench (commercial).
TAVILY_API_KEY=

# DeepResearchGym / ClueWeb / FineWeb retrieval sandbox.
# FineWeb is typically immediate; ClueWeb22 needs a data-use agreement.
DEEPRESEARCHGYM_API_KEY=
DEEPRESEARCHGYM_SEARCH_URL=https://clueweb22.us/search
DEEPRESEARCHGYM_FETCH_URL=https://clueweb22.us/fetch
DEEPRESEARCHGYM_CORPUS=fineweb
